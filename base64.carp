(defmodule Base64
  (doc mime-charset "The Base64 character set as specified by MIME.")
  (def mime-charset
    (to-bytes "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"))

  (doc mime-padding "The Base64 padding as specified by MIME.")
  (def mime-padding 61b)
  ; => \= as byte

  (doc url-charset
    "The URL- and filename-safe Base64 character set (RFC 4648 section 5).")
  (def url-charset (Array.aset (Array.aset @&mime-charset 62 45b) 63 95b))
  ; derived from mime-charset: index 62 + -> - (45b), index 63 / -> _ (95b)

  ; reverse-lookup tables map an alphabet byte back to its 6-bit value in O(1),
  ; with 255 marking a byte that is not part of the alphabet.
  (private make-revtable)
  (hidden make-revtable)
  (sig make-revtable (λ [&(Array Byte)] (Array Byte)))
  (defn make-revtable [charset]
    (let-do [table (Array.replicate 256 &255b)]
      (for [i 0 (Array.length charset)]
        (Array.aset! &table
                     (to-int @(Array.unsafe-nth charset i))
                     (Byte.from-int i)))
      table))

  (private mime-revtable)
  (hidden mime-revtable)
  (def mime-revtable (make-revtable &mime-charset))

  (private url-revtable)
  (hidden url-revtable)
  (def url-revtable (make-revtable &url-charset))

  (private rev)
  (hidden rev)
  (sig rev (λ [&(Array Byte) &Byte] Byte))
  (defn rev [revtable byte] @(Array.unsafe-nth revtable (to-int @byte)))

  (private validate)
  (hidden validate)
  (sig validate (λ [&(Array Byte) &Byte &(Array Byte)] (Result Bool String)))
  (defn validate [revtable padding bytes]
    (let [len (Array.length bytes)]
      (cond
        (= len 0) (Result.Success true)
        (/= (mod len 4) 0)
          (Result.Error @"input length must be a multiple of 4")
        (let-do [i 0
                 error (Maybe.Nothing)
                 seen-pad false]
          (while-do (and (< i len) (Maybe.nothing? &error))
            (let [b (Array.unsafe-nth bytes i)]
              (cond
                (and (= @b @padding) (< i (- len 2)))
                  (set! error (Maybe.Just @"padding in non-terminal position"))
                (= @b @padding) (set! seen-pad true)
                seen-pad
                  (set! error (Maybe.Just @"non-padding byte after padding"))
                (when (= (rev revtable b) 255b)
                  (set! error (Maybe.Just @"invalid character in input")))))
            (set! i (inc i)))
          (match error
            (Maybe.Just e) (Result.Error e)
            (Maybe.Nothing) (Result.Success true))))))

  (private decode-with-table)
  (hidden decode-with-table)
  (sig decode-with-table
       (λ [&(Array Byte) &Byte &String] (Result (Array Byte) String)))
  (defn decode-with-table [revtable padding s]
    (let [bytes (to-bytes s)]
      (match (validate revtable padding &bytes)
        (Result.Error e) (Result.Error e)
        (Result.Success _)
          (let-do [decoded []
                   len (Array.length &bytes)
                   idx 0]
            (while (< idx len)
              (let-do [b0 (rev revtable (Array.unsafe-nth &bytes idx))
                       b1 (rev revtable (Array.unsafe-nth &bytes (+ idx 1)))
                       third (Array.unsafe-nth &bytes (+ idx 2))
                       b2 (rev revtable third)
                       fourth (Array.unsafe-nth &bytes (+ idx 3))
                       b3 (rev revtable fourth)]
                (set! decoded
                      (Array.push-back decoded
                                       (bit-or (bit-shift-left (bit-and b0 63b)
                                                               2b)
                                               (bit-shift-right b1 4b))))
                (when (/= third padding)
                  (set! decoded
                        (Array.push-back decoded
                                         (bit-or (bit-shift-left (bit-and b1 15b)
                                                                 4b)
                                                 (bit-shift-right b2 2b)))))
                (when (/= fourth padding)
                  (set! decoded
                        (Array.push-back decoded
                                         (bit-or (bit-shift-left (bit-and b2 3b)
                                                                 6b)
                                                 b3))))
                (set! idx (+ idx 4))))
            (Result.Success decoded)))))

  (doc decode-using
    "Decodes a base64-encoded datum using a user-supplied character set.
     Returns a Result with the decoded bytes or an error string.")
  (sig decode-using
       (λ [&(Array Byte) &Byte &String] (Result (Array Byte) String)))
  (defn decode-using [charset padding s]
    (decode-with-table &(make-revtable charset) padding s))

  (doc decode "Decodes a base64-encoded datum using mime-charset.")
  (defn decode [x] (decode-with-table &mime-revtable &mime-padding x))

  (doc decode-str "Decodes a base64-encoded string using mime-charset.")
  (defn decode-str [s]
    (match (decode s)
      (Result.Success bytes) (Result.Success (from-bytes &bytes))
      (Result.Error e) (Result.Error e)))

  (doc encode-using
    "Encodes a datum into base64 using a user-supplied character set.")
  (sig encode-using (λ [&(Array Byte) Byte &(Array Byte)] String))
  (defn encode-using [charset pad s]
    (let-do [l (Array.length s)
             idx 0
             enc []]
      (while (> l idx)
        (let-do [b0 @(Array.unsafe-nth s idx)]
          (case (- l idx)
                1
                (let-do [c0 @(Array.unsafe-nth charset
                                               (to-int (bit-shift-right b0 2b)))
                         c1 @(Array.unsafe-nth charset
                                               (to-int (bit-shift-left (bit-and b0
                                                                                3b)
                                                                       4b)))]
                  (set! enc (Array.push-back enc c0))
                  (set! enc (Array.push-back enc c1))
                  (set! enc (Array.push-back enc pad))
                  (set! enc (Array.push-back enc pad))
                  (break))
                2
                (let-do [b1 @(Array.unsafe-nth s (inc idx))
                         c0 @(Array.unsafe-nth charset
                                               (to-int (bit-shift-right b0 2b)))
                         c1 @(Array.unsafe-nth charset
                                               (to-int
                                                 (bit-or (bit-shift-left (bit-and b0
                                                                                  3b)
                                                                         4b)
                                                         (bit-shift-right b1 4b))))
                         c2 @(Array.unsafe-nth charset
                                               (to-int (bit-shift-left (bit-and b1
                                                                                15b)
                                                                       2b)))]
                  (set! enc (Array.push-back enc c0))
                  (set! enc (Array.push-back enc c1))
                  (set! enc (Array.push-back enc c2))
                  (set! enc (Array.push-back enc pad))
                  (break))
                (let-do [b1 @(Array.unsafe-nth s (inc idx))
                         b2 @(Array.unsafe-nth s (+ idx 2))
                         c0 @(Array.unsafe-nth charset
                                               (to-int (bit-shift-right b0 2b)))
                         c1 @(Array.unsafe-nth charset
                                               (to-int
                                                 (bit-or (bit-shift-left (bit-and b0
                                                                                  3b)
                                                                         4b)
                                                         (bit-shift-right b1 4b))))
                         c2 @(Array.unsafe-nth charset
                                               (to-int
                                                 (bit-or (bit-shift-left (bit-and b1
                                                                                  15b)
                                                                         2b)
                                                         (bit-shift-right b2 6b))))
                         c3 @(Array.unsafe-nth charset (to-int (bit-and b2 63b)))]
                  (set! enc (Array.push-back enc c0))
                  (set! enc (Array.push-back enc c1))
                  (set! enc (Array.push-back enc c2))
                  (set! enc (Array.push-back enc c3))
                  (set! idx (+ idx 3))))))
      (from-bytes &enc)))

  (doc encode "Encodes a datum into base64 using mime-charset.")
  (defn encode [s] (encode-using &mime-charset mime-padding s))

  (doc encode-str "Encodes a string into base64 using mime-charset.")
  (defn encode-str [s] (encode-using &mime-charset mime-padding &(to-bytes s)))

  (doc encode-url
    "Encodes a datum into URL- and filename-safe base64 (RFC 4648 section 5).")
  (defn encode-url [s] (encode-using &url-charset mime-padding s))

  (doc encode-url-str
    "Encodes a string into URL- and filename-safe base64 (RFC 4648 section 5).")
  (defn encode-url-str [s]
    (encode-using &url-charset mime-padding &(to-bytes s)))

  (private pad-to-multiple)
  (hidden pad-to-multiple)
  (sig pad-to-multiple (λ [&String] String))
  (defn pad-to-multiple [s]
    (case (mod (String.length s) 4)
          2
          (String.append s "==")
          3
          (String.append s "=")
          @s))

  (doc decode-url
    "Decodes a URL- and filename-safe base64 datum (RFC 4648 section 5).
     Accepts input with or without `=` padding.")
  (defn decode-url [s]
    (decode-with-table &url-revtable &mime-padding &(pad-to-multiple s)))

  (doc decode-url-str
    "Decodes a URL- and filename-safe base64 string (RFC 4648 section 5).
     Accepts input with or without `=` padding.")
  (defn decode-url-str [s]
    (match (decode-url s)
      (Result.Success bytes) (Result.Success (from-bytes &bytes))
      (Result.Error e) (Result.Error e))))
