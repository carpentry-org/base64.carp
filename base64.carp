(defmodule Base64
  (doc mime-charset "The Base64 character set as specified by MIME.")
  (def mime-charset
    (to-bytes "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"))

  (doc mime-padding "The Base64 padding as specified by MIME.")
  (def mime-padding 61b)
  ; => \= as byte

  (private get-from-charset)
  (hidden get-from-charset)
  (defn get-from-charset [charset byte]
    (Byte.from-int (Maybe.from (Array.index-of charset byte) 0)))

  (private validate)
  (hidden validate)
  (sig validate (λ [&(Array Byte) &Byte &(Array Byte)] (Result Bool String)))
  (defn validate [charset padding bytes]
    (let [len (Array.length bytes)]
      (cond
        (= len 0) (Result.Success true)
        (/= (mod len 4) 0)
          (Result.Error @"input length must be a multiple of 4")
        (let-do [i 0
                 error (Maybe.Nothing)
                 seen-pad false]
          (while-do (and (< i len) (Maybe.nothing? &error))
            (let [b (Array.unsafe-nth bytes i)]
              (cond
                (and (= @b @padding) (< i (- len 2)))
                  (set! error (Maybe.Just @"padding in non-terminal position"))
                (= @b @padding) (set! seen-pad true)
                seen-pad
                  (set! error (Maybe.Just @"non-padding byte after padding"))
                (when (Maybe.nothing? &(Array.index-of charset b))
                  (set! error (Maybe.Just @"invalid character in input")))))
            (set! i (inc i)))
          (match error
            (Maybe.Just e) (Result.Error e)
            (Maybe.Nothing) (Result.Success true))))))

  (doc decode-using
    "Decodes a base64-encoded datum using a user-supplied character set.
     Returns a Result with the decoded bytes or an error string.")
  (sig decode-using
       (λ [&(Array Byte) &Byte &String] (Result (Array Byte) String)))
  (defn decode-using [charset padding s]
    (let [bytes (to-bytes s)]
      (match (validate charset padding &bytes)
        (Result.Error e) (Result.Error e)
        (Result.Success _)
          (let-do [decoded []
                   len (Array.length &bytes)
                   idx 0]
            (while (< idx len)
              (let-do [b0 (get-from-charset charset
                                            (Array.unsafe-nth &bytes idx))
                       b1 (get-from-charset charset
                                            (Array.unsafe-nth &bytes (+ idx 1)))
                       third (Array.unsafe-nth &bytes (+ idx 2))
                       b2 (get-from-charset charset third)
                       fourth (Array.unsafe-nth &bytes (+ idx 3))
                       b3 (get-from-charset charset fourth)]
                (set! decoded
                      (Array.push-back decoded
                                       (bit-or (bit-shift-left (bit-and b0 63b)
                                                               2b)
                                               (bit-shift-right b1 4b))))
                (when (/= third padding)
                  (set! decoded
                        (Array.push-back decoded
                                         (bit-or (bit-shift-left (bit-and b1 15b)
                                                                 4b)
                                                 (bit-shift-right b2 2b)))))
                (when (/= fourth padding)
                  (set! decoded
                        (Array.push-back decoded
                                         (bit-or (bit-shift-left (bit-and b2 3b)
                                                                 6b)
                                                 b3))))
                (set! idx (+ idx 4))))
            (Result.Success decoded)))))

  (doc decode "Decodes a base64-encoded datum using mime-charset.")
  (defn decode [x] (decode-using &mime-charset &mime-padding x))

  (doc decode-str "Decodes a base64-encoded string using mime-charset.")
  (defn decode-str [s]
    (match (decode s)
      (Result.Success bytes) (Result.Success (from-bytes &bytes))
      (Result.Error e) (Result.Error e)))

  (doc encode-using
    "Encodes a datum into base64 using a user-supplied character set.")
  (sig encode-using (λ [&(Array Byte) Byte &(Array Byte)] String))
  (defn encode-using [charset pad s]
    (let-do [l (Array.length s)
             idx 0
             enc []]
      (while (> l idx)
        (let-do [b0 @(Array.unsafe-nth s idx)]
          (case (- l idx)
                1
                (let-do [c0 @(Array.unsafe-nth charset
                                               (to-int (bit-shift-right b0 2b)))
                         c1 @(Array.unsafe-nth charset
                                               (to-int (bit-shift-left (bit-and b0
                                                                                3b)
                                                                       4b)))]
                  (set! enc (Array.push-back enc c0))
                  (set! enc (Array.push-back enc c1))
                  (set! enc (Array.push-back enc pad))
                  (set! enc (Array.push-back enc pad))
                  (break))
                2
                (let-do [b1 @(Array.unsafe-nth s (inc idx))
                         c0 @(Array.unsafe-nth charset
                                               (to-int (bit-shift-right b0 2b)))
                         c1 @(Array.unsafe-nth charset
                                               (to-int
                                                 (bit-or (bit-shift-left (bit-and b0
                                                                                  3b)
                                                                         4b)
                                                         (bit-shift-right b1 4b))))
                         c2 @(Array.unsafe-nth charset
                                               (to-int (bit-shift-left (bit-and b1
                                                                                15b)
                                                                       2b)))]
                  (set! enc (Array.push-back enc c0))
                  (set! enc (Array.push-back enc c1))
                  (set! enc (Array.push-back enc c2))
                  (set! enc (Array.push-back enc pad))
                  (break))
                (let-do [b1 @(Array.unsafe-nth s (inc idx))
                         b2 @(Array.unsafe-nth s (+ idx 2))
                         c0 @(Array.unsafe-nth charset
                                               (to-int (bit-shift-right b0 2b)))
                         c1 @(Array.unsafe-nth charset
                                               (to-int
                                                 (bit-or (bit-shift-left (bit-and b0
                                                                                  3b)
                                                                         4b)
                                                         (bit-shift-right b1 4b))))
                         c2 @(Array.unsafe-nth charset
                                               (to-int
                                                 (bit-or (bit-shift-left (bit-and b1
                                                                                  15b)
                                                                         2b)
                                                         (bit-shift-right b2 6b))))
                         c3 @(Array.unsafe-nth charset (to-int (bit-and b2 63b)))]
                  (set! enc (Array.push-back enc c0))
                  (set! enc (Array.push-back enc c1))
                  (set! enc (Array.push-back enc c2))
                  (set! enc (Array.push-back enc c3))
                  (set! idx (+ idx 3))))))
      (from-bytes &enc)))

  (doc encode "Encodes a datum into base64 using mime-charset.")
  (defn encode [s] (encode-using &mime-charset mime-padding s))

  (doc encode-str "Encodes a string into base64 using mime-charset.")
  (defn encode-str [s] (encode-using &mime-charset mime-padding &(to-bytes s))))
