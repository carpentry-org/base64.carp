(load "base64.carp")
(load "Test.carp")
(use-all Base64 Test)

(defn main []
  (with-test test
    (assert-equal test
      "AgME"
      &(encode &[2b 3b 4b])
      "test that encoding data works")
    (assert-equal test
      "SGVsbG8h"
      &(encode-str "Hello!")
      "test that encoding strings works")
    (assert-equal test
      &[2b 3b 4b]
      &(decode "AgME")
      "test that decoding data works")
    (assert-equal test
      "Hello"
      &(decode-str "SGVsbG8=")
      "test that decoding strings works")
    (assert-equal test
      "aMO2eQ=="
      &(encode-str "höy")
      "test that encoding UTF8 strings works")
    (assert-equal test
      "höy"
      &(decode-str "aMO2eQ==")
      "test that decoding UTF8 strings works")
    (assert-equal test
      "UA=="
      &(encode-str "P")
      "test that index 20 (U) encodes correctly")
    (assert-equal test
      "P"
      &(decode-str "UA==")
      "test that index 20 (U) decodes correctly")
    (assert-equal test
      &[2b 3b 4b]
      &(decode &(encode &[2b 3b 4b]))
      "roundtrip: short binary data")
    (assert-equal test
      "Hello!"
      &(decode-str &(encode-str "Hello!"))
      "roundtrip: ASCII string")
    (assert-equal test
      "höy"
      &(decode-str &(encode-str "höy"))
      "roundtrip: UTF8 string")))
