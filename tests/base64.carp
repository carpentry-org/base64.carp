(load "base64.carp")
(load "Test.carp")
(use-all Base64 Test)

(defn main []
  (with-test test
    (assert-equal test
      "AgME"
      &(encode &[2b 3b 4b])
      "test that encoding data works")
    (assert-equal test
      "SGVsbG8h"
      &(encode-str "Hello!")
      "test that encoding strings works")
    (assert-equal test
      "aMO2eQ=="
      &(encode-str "höy")
      "test that encoding UTF8 strings works")
    (assert-equal test
      "UA=="
      &(encode-str "P")
      "test that index 20 (U) encodes correctly")
    (assert-equal test "" &(encode &[]) "encode empty input")
    (assert-equal test "AA==" &(encode &[0b]) "encode single zero byte")
    (assert-equal test "AAA=" &(encode &[0b 0b]) "encode two zero bytes")
    (assert-equal test
      "AAAA"
      &(encode &[0b 0b 0b])
      "encode three zero bytes (no padding)")
    (assert-equal test "/w==" &(encode &[255b]) "encode max byte value")
    (assert-equal test
      "AQIDBAUGCA=="
      &(encode &[1b 2b 3b 4b 5b 6b 8b])
      "encode multi-chunk with remainder")

    (assert-equal test
      &(Result.Success [2b 3b 4b])
      &(decode "AgME")
      "test that decoding data works")
    (assert-equal test
      &(Result.Success @"Hello")
      &(decode-str "SGVsbG8=")
      "test that decoding strings works")
    (assert-equal test
      &(Result.Success @"höy")
      &(decode-str "aMO2eQ==")
      "test that decoding UTF8 strings works")
    (assert-equal test
      &(Result.Success @"P")
      &(decode-str "UA==")
      "test that index 20 (U) decodes correctly")
    (assert-equal test &(Result.Success []) &(decode "") "decode empty input")
    (assert-equal test
      &(Result.Success [0b])
      &(decode "AA==")
      "decode single zero byte")
    (assert-equal test
      &(Result.Success [0b 0b])
      &(decode "AAA=")
      "decode two zero bytes")
    (assert-equal test
      &(Result.Success [0b 0b 0b])
      &(decode "AAAA")
      "decode three zero bytes (no padding)")
    (assert-equal test
      &(Result.Success [255b])
      &(decode "/w==")
      "decode max byte value")

    (assert-equal test
      &(Result.Error @"input length must be a multiple of 4")
      &(decode "A")
      "reject length 1")
    (assert-equal test
      &(Result.Error @"input length must be a multiple of 4")
      &(decode "AB")
      "reject length 2")
    (assert-equal test
      &(Result.Error @"input length must be a multiple of 4")
      &(decode "ABC")
      "reject length 3")
    (assert-equal test
      &(Result.Error @"input length must be a multiple of 4")
      &(decode "ABCDE")
      "reject length 5")

    (assert-equal test
      &(Result.Error @"invalid character in input")
      &(decode "!!!!")
      "reject invalid characters")
    (assert-equal test
      &(Result.Error @"invalid character in input")
      &(decode "AB C")
      "reject whitespace in input")

    (assert-equal test
      &(Result.Error @"padding in non-terminal position")
      &(decode "=AAA")
      "reject padding at start")
    (assert-equal test
      &(Result.Error @"padding in non-terminal position")
      &(decode "A=AA")
      "reject padding in second position")
    (assert-equal test
      &(Result.Error @"non-padding byte after padding")
      &(decode "AB=C")
      "reject non-padding after padding")
    (assert-equal test
      &(Result.Error @"padding in non-terminal position")
      &(decode "ABCD====")
      "reject too much padding in multi-chunk")

    (assert-equal test
      &(Result.Success [2b 3b 4b])
      &(decode &(encode &[2b 3b 4b]))
      "roundtrip: short binary data")
    (assert-equal test
      &(Result.Success @"Hello!")
      &(decode-str &(encode-str "Hello!"))
      "roundtrip: ASCII string")
    (assert-equal test
      &(Result.Success @"höy")
      &(decode-str &(encode-str "höy"))
      "roundtrip: UTF8 string")
    (assert-equal test
      &(Result.Success [])
      &(decode &(encode &[]))
      "roundtrip: empty input")
    (assert-equal test
      &(Result.Success [42b])
      &(decode &(encode &[42b]))
      "roundtrip: single byte")
    (assert-equal test
      &(Result.Success [42b 43b])
      &(decode &(encode &[42b 43b]))
      "roundtrip: two bytes")
    (assert-equal test
      &(Result.Success [1b 2b 3b 4b 5b 6b 7b 8b 9b])
      &(decode &(encode &[1b 2b 3b 4b 5b 6b 7b 8b 9b]))
      "roundtrip: multi-chunk")

    (assert-equal test
      "-A=="
      &(encode-url &[248b])
      "url-safe encode maps + to - (standard: +A==)")
    (assert-equal test
      "_w=="
      &(encode-url &[255b])
      "url-safe encode maps / to _ (standard: /w==)")
    (assert-equal test
      "__8="
      &(encode-url &[255b 255b])
      "url-safe encode of two max bytes (standard: //8=)")
    (assert-equal test
      "-_AA"
      &(encode-url &[251b 240b 0b])
      "url-safe encode uses both - and _ (standard: +/AA)")
    (assert-equal test "" &(encode-url &[]) "url-safe encode empty input")
    (assert-equal test
      "YWE_"
      &(encode-url-str "aa?")
      "url-safe encode-str maps / to _ (standard: YWE/)")
    (assert-equal test
      "YWE-"
      &(encode-url-str "aa>")
      "url-safe encode-str maps + to - (standard: YWE+)")

    (assert-equal test
      &(Result.Success [248b])
      &(decode-url "-A==")
      "url-safe decode padded, remainder 1")
    (assert-equal test
      &(Result.Success [255b 255b])
      &(decode-url "__8=")
      "url-safe decode padded, remainder 2")
    (assert-equal test
      &(Result.Success [251b 240b 0b])
      &(decode-url "-_AA")
      "url-safe decode, remainder 0 (no padding)")
    (assert-equal test
      &(Result.Success [])
      &(decode-url "")
      "url-safe decode empty input")

    (assert-equal test
      &(Result.Success [248b])
      &(decode-url "-A")
      "url-safe decode unpadded, remainder 1")
    (assert-equal test
      &(Result.Success [255b 255b])
      &(decode-url "__8")
      "url-safe decode unpadded, remainder 2")
    (assert-equal test
      &(decode-url "-A==")
      &(decode-url "-A")
      "url-safe padded and unpadded decode agree (remainder 1)")
    (assert-equal test
      &(decode-url "__8=")
      &(decode-url "__8")
      "url-safe padded and unpadded decode agree (remainder 2)")

    (assert-equal test
      &(Result.Success @"aa?")
      &(decode-url-str "YWE_")
      "url-safe decode-str works")

    (assert-equal test
      &(decode "+A==")
      &(decode-url "-A==")
      "url-safe and standard decode agree (+ vs -)")
    (assert-equal test
      &(decode "//8=")
      &(decode-url "__8=")
      "url-safe and standard decode agree (/ vs _)")
    (assert-equal test
      &(decode "+/AA")
      &(decode-url "-_AA")
      "url-safe and standard decode agree (+/ vs -_)")

    (assert-equal test
      &(Result.Error @"invalid character in input")
      &(decode-url "+A==")
      "url-safe decode rejects standard +")
    (assert-equal test
      &(Result.Error @"invalid character in input")
      &(decode-url "/w==")
      "url-safe decode rejects standard /")

    (assert-equal test
      &(Result.Success [251b 240b 0b])
      &(decode-url &(encode-url &[251b 240b 0b]))
      "url-safe roundtrip: remainder 0")
    (assert-equal test
      &(Result.Success [248b])
      &(decode-url &(encode-url &[248b]))
      "url-safe roundtrip: remainder 1")
    (assert-equal test
      &(Result.Success [255b 255b])
      &(decode-url &(encode-url &[255b 255b]))
      "url-safe roundtrip: remainder 2")
    (assert-equal test
      &(Result.Success [])
      &(decode-url &(encode-url &[]))
      "url-safe roundtrip: empty")
    (assert-equal test
      &(Result.Success @"aa?")
      &(decode-url-str &(encode-url-str "aa?"))
      "url-safe roundtrip: string")
    (assert-equal test
      &(Result.Success [1b 2b 3b 4b 5b 6b 7b 8b 9b])
      &(decode-url &(encode-url &[1b 2b 3b 4b 5b 6b 7b 8b 9b]))
      "url-safe roundtrip: multi-chunk")))
